# Raw background source library (254 stock images, ~130MB) is too large for
# the repo and stays local-only on this machine. The small processed set that
# the print sheet and mockups actually reference is kept.
design/backgrounds/*
!design/backgrounds/selected/

# Third-party reference PDFs (Disney Lorcana rules, Into Film GAMERS docs,
# CSTA/AI4K12 report) — copyrighted material kept local-only, not redistributed.
/*.pdf

# OS/editor junk
.DS_Store
Thumbs.db
*.log

# v2 card frame: PNG renders stay local (regenerate from the committed HTML).
design/frame-v2/*.png
# icon previews made with build-card.js --icon=... are throwaway
design/frame-v2/preview-*.html

# Card artwork stays local; only the file-name checklist and optional name map are committed
/design/icons/*
!/design/icons/README.md
!/design/icons/icons.json
